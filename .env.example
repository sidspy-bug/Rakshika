# ─── Rakshika Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ─── DATABASE ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@postgres:5432/rakshika_db

# ─── REDIS ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── AI SERVICE (OpenRouter) ──────────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
GEMINI_API_KEY=

# ─── NOTIFICATION SERVICE ─────────────────────────────────────────────────
# Firebase Cloud Messaging (ask your collaborator for the credentials file)
FIREBASE_CREDENTIALS_PATH=services/notification-service/app/firebase-credentials.json

# SMTP Email Alerts (for notifying emergency contacts)
# You can use Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Base URL for evidence live feed links in alert emails
EMERGENCY_EVIDENCE_BASE_URL=http://localhost:8000/api/v1

# ─── MOBILE APP ───────────────────────────────────────────────────────────
# Google Maps API key (for react-native-maps)
GOOGLE_MAPS_API_KEY=
